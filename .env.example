# Ticket category/listing page to monitor. Numbered pages are scanned for a
# title matching every -k term. A direct product URL can also be used.
PRODUCT_URL=https://audidefuehrungen2.regiondo.de/kategorien

# Only needed if this product page presents a login form.
SITE_USERNAME=
SITE_PASSWORD=

# Browser mode: true or false
HEADLESS=false

# SMTP settings (587 = STARTTLS, 465 = implicit TLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=ticketfinder@example.com
EMAIL_TO=your-address@example.com
